{
  "name": "google-pro-assistant",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local subscription-only Gemini CLI and Google Flow MCP for Claude and Codex",
  "bin": { "google-pro": "./dist/cli.js" },
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "tsc",
    "test": "tsx --test test/*.test.ts",
    "start": "node dist/server.js",
    "setup": "npm run build && node dist/setup.js",
    "doctor": "node dist/cli.js doctor"
  },
  "dependencies": {
    "@google/gemini-cli": "0.66.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "playwright": "1.64.1",
    "zod": "^4.3.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
